# AWS Configuration
AWS_REGION=us-east-1
AWS_PROFILE=default

# Bedrock Agent Configuration
AGENT_ID=your-agent-id-here
AGENT_ALIAS_ID=your-agent-alias-id-here

# DynamoDB Configuration
PREFERENCES_TABLE_NAME=f1-agent-preferences
INTERACTIONS_TABLE_NAME=f1-agent-interactions

# API Configuration
OPENF1_API_BASE_URL=https://api.openf1.org/v1
WEATHER_API_KEY=your-weather-api-key-here

# Feature Flags
ENABLE_CACHING=true
MAX_RETRIES=3
REQUEST_TIMEOUT=30

# Logging
LOG_LEVEL=INFO
